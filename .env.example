# Wajib diganti dengan string acak panjang pada production.
DOWNLOAD_TOKEN_SECRET=change-me-with-a-long-random-value

# Batas ruang kerja. Vercel Functions menyediakan /tmp hingga sekitar 500 MB.
# 220 MB menjaga peak pemakaian /tmp saat source video+audio dan output merge
# berada bersamaan. Naikkan hanya jika runtime punya storage lebih besar.
MAX_MEDIA_BYTES=230686720
DOWNLOAD_TOKEN_MAX_AGE=900
HTTP_TIMEOUT=30
# Batas waktu konversi FFmpeg dalam detik.
FFMPEG_TIMEOUT=3600
# Sembunyikan pilihan video yang perkiraan konversinya lebih lama dari ini
# (detik). Bawaan 240 di Vercel, 0 (tanpa batas) di tempat lain.
# TRANSCODE_TIME_LIMIT=240
# Kecepatan konversi server dalam piksel per detik, dipakai untuk perkiraan itu.
TRANSCODE_PIXEL_RATE=15000000
# Jumlah item carousel dan link paket yang diproses bersamaan.
GALLERY_CONCURRENCY=4
BATCH_CONCURRENCY=2

# Proteksi akses publik. Kosongkan ACCESS_PASSWORD untuk pemakaian lokal.
ACCESS_USERNAME=linkdrop
ACCESS_PASSWORD=
# Lama browser tetap masuk (hari) sejak terakhir dipakai.
ACCESS_SESSION_DAYS=30
# Isi CF-Connecting-IP hanya jika Linkdrop diakses lewat Cloudflare Tunnel
# dan port aplikasi tidak terbuka ke jaringan lain.
TRUSTED_PROXY_HEADER=
# Format jumlah/detik per alamat pengunjung, atau off.
RATE_LIMIT_INFO=30/60
RATE_LIMIT_DOWNLOAD=20/600

# Opsional untuk deployment. Isi dengan base64 dari cookies.txt Netscape.
# Jangan gunakan cookie akun utama pada aplikasi publik.
YTDLP_COOKIES_B64=

# Hanya untuk development lokal:
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=
