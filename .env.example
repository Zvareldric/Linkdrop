# Wajib diganti dengan string acak panjang pada production.
DOWNLOAD_TOKEN_SECRET=change-me-with-a-long-random-value

# Batas ruang kerja. Vercel Functions menyediakan /tmp hingga sekitar 500 MB.
# 220 MB menjaga peak pemakaian /tmp saat source video+audio dan output merge
# berada bersamaan. Naikkan hanya jika runtime punya storage lebih besar.
MAX_MEDIA_BYTES=230686720
DOWNLOAD_TOKEN_MAX_AGE=900
HTTP_TIMEOUT=30

# Opsional untuk deployment. Isi dengan base64 dari cookies.txt Netscape.
# Jangan gunakan cookie akun utama pada aplikasi publik.
YTDLP_COOKIES_B64=

# Hanya untuk development lokal:
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=
